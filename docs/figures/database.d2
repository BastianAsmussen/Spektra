# Spektra database diagram. Generated by docs/figures/gen-db-d2.sh, rendered with
# docs/figures/build.sh. Header colour is the table's group, matching the subsystem
# colours in arkitektur.d2.
#
# The uniform audit columns (created_at, updated_at) are left out to keep the
# figure readable. The migrations have them.

vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    theme-overrides: {
      B1: "#4c4f69"
      B2: "#4c4f69"
      AA2: "#6c6f85"
    }
  }
}

direction: down

classes: {
  adgang: {
    style: {
      fill: "#c3e1b8"
      stroke: "#ffffff"
      font-color: "#4c4f69"
      font-size: 18
      stroke-width: 0
    }
  }
  flaade: {
    style: {
      fill: "#bfd1fb"
      stroke: "#ffffff"
      font-color: "#4c4f69"
      font-size: 18
      stroke-width: 0
    }
  }
  maaledata: {
    style: {
      fill: "#dcc3fa"
      stroke: "#ffffff"
      font-color: "#4c4f69"
      font-size: 18
      stroke-width: 0
    }
  }
  haendelser: {
    style: {
      fill: "#ffcfb2"
      stroke: "#ffffff"
      font-color: "#4c4f69"
      font-size: 18
      stroke-width: 0
    }
  }
}

forklaring: "" {
  grid-rows: 1
  horizontal-gap: 24
  style: {fill: transparent; stroke: transparent}
tabelgrupper: "Tabelgrupper" {
  grid-columns: 1
  grid-gap: 8
  style: {fill: "#ffffff"; stroke: "#9ca0b0"; font-color: "#4c4f69"; font-size: 19; bold: false}
  adgang: "Adgang" {class: adgang; width: 150; height: 40; style.bold: false; style.font-size: 17}
  flaade: "Flåde" {class: flaade; width: 150; height: 40; style.bold: false; style.font-size: 17}
  maaledata: "Måledata" {class: maaledata; width: 150; height: 40; style.bold: false; style.font-size: 17}
  haendelser: "Hændelser" {class: haendelser; width: 150; height: 40; style.bold: false; style.font-size: 17}
}
enumtyper: "Enumtyper" {
  style: {fill: "#ffffff"; stroke: "#9ca0b0"; font-color: "#4c4f69"; font-size: 19; bold: false}
  modulation: {
    shape: sql_table
    style.fill: "#dce0e8"
    style.stroke: "#ffffff"
    style.font-color: "#4c4f69"
    fm: ""
    dab: ""
  }
  metric: {
    shape: sql_table
    style.fill: "#dce0e8"
    style.stroke: "#ffffff"
    style.font-color: "#4c4f69"
    signal_strength: ""
    signal_to_noise: ""
    carrier_offset: ""
    demod_error_rate: ""
    spectrum_occupancy: ""
  }
  rollup_resolution: {
    shape: sql_table
    style.fill: "#dce0e8"
    style.stroke: "#ffffff"
    style.font-color: "#4c4f69"
    hourly: ""
    daily: ""
    weekly: ""
  }
  alarm_state: {
    shape: sql_table
    style.fill: "#dce0e8"
    style.stroke: "#ffffff"
    style.font-color: "#4c4f69"
    open: ""
    acknowledged: ""
    under_verification: ""
    closed: ""
  }
  work_order_status: {
    shape: sql_table
    style.fill: "#dce0e8"
    style.stroke: "#ffffff"
    style.font-color: "#4c4f69"
    assigned: ""
    completed: ""
  }
}
}

roles: {
  shape: sql_table
  class: adgang
  id: bigserial {constraint: primary_key}
  name: varchar(32) {constraint: unique}
  description: text
}
users: {
  shape: sql_table
  class: adgang
  id: bigserial {constraint: primary_key}
  email: varchar(320) {constraint: unique}
  password_hash: text
  full_name: varchar(100)
  role_id: bigint {constraint: foreign_key}
  deactivated: boolean
}
sessions: {
  shape: sql_table
  class: adgang
  id: bigserial {constraint: primary_key}
  token: varchar(255) {constraint: unique}
  user_id: bigint {constraint: foreign_key}
  expires_at: timestamp
  last_used_at: timestamp
}

nodes: {
  shape: sql_table
  class: flaade
  id: bigserial {constraint: primary_key}
  external_identity: varchar(64) {constraint: unique}
  name: varchar(100)
  latitude: float8
  longitude: float8
  hardware: jsonb
  capabilities: jsonb
  suspended: boolean
  report_interval_seconds: int
  channel_plan_version: bigint
  owner_id: bigint {constraint: foreign_key}
  last_seen_at: timestamp
}
node_credentials: {
  shape: sql_table
  class: flaade
  id: bigserial {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  token: varchar(255) {constraint: unique}
  expires_at: timestamp
  revoked_at: timestamp
}
channels: {
  shape: sql_table
  class: flaade
  id: bigserial {constraint: primary_key}
  name: varchar(100)
  frequency_hz: bigint {constraint: unique}
  modulation: modulation (enum) {constraint: unique}
}
node_channels: {
  shape: sql_table
  class: flaade
  id: bigserial {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  channel_id: bigint {constraint: foreign_key}
  bandwidth_hz: integer
}

measurements: {
  shape: sql_table
  class: maaledata
  id: bigserial {constraint: primary_key}
  window_start: timestamp {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  channel_id: bigint {constraint: foreign_key}
  metric: metric (enum)
  window_end: timestamp
  min: float8
  max: float8
  mean: float8
  median: float8
  stddev: float8
  p95: float8
  sample_count: bigint
}
rollups: {
  shape: sql_table
  class: maaledata
  id: bigserial {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  channel_id: bigint {constraint: foreign_key}
  metric: metric (enum)
  resolution: rollup_resolution (enum)
  bucket_start: timestamp
  bucket_end: timestamp
  min: float8
  max: float8
  mean: float8
  median: float8
  stddev: float8
  sample_count: bigint
}
node_health: {
  shape: sql_table
  class: maaledata
  id: bigserial {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  measured_at: timestamp {constraint: unique}
  uptime_seconds: float8
  load_1m: float8
  load_5m: float8
  load_15m: float8
  cpu_temperature_celsius: float8
  clock_offset_seconds: float8
}

alarms: {
  shape: sql_table
  class: haendelser
  id: bigserial {constraint: primary_key}
  node_id: bigint {constraint: foreign_key}
  channel_id: bigint {constraint: foreign_key}
  metric: metric (enum)
  state: alarm_state (enum)
  explanation: jsonb
  raised_at: timestamp
  closed_at: timestamp
}
alarm_events: {
  shape: sql_table
  class: haendelser
  id: bigserial {constraint: primary_key}
  alarm_id: bigint {constraint: foreign_key}
  from_state: alarm_state (enum)
  to_state: alarm_state (enum)
  changed_by_user_id: bigint {constraint: foreign_key}
  reason: text
}
work_orders: {
  shape: sql_table
  class: haendelser
  id: bigserial {constraint: primary_key}
  alarm_id: bigint {constraint: foreign_key}
  technician_user_id: bigint {constraint: foreign_key}
  station_name: text
  status: work_order_status (enum)
  fault_present: boolean
  cause: text
  action_taken: text
  completed_at: timestamp
}

forklaring.tabelgrupper -> alarm_events: {style.opacity: 0}
forklaring.enumtyper -> work_orders: {style.opacity: 0}
users.role_id -> roles.id
sessions.user_id -> users.id
nodes.owner_id -> users.id
node_credentials.node_id -> nodes.id
node_channels.node_id -> nodes.id
node_channels.channel_id -> channels.id
measurements.node_id -> nodes.id
measurements.channel_id -> channels.id
rollups.node_id -> nodes.id
rollups.channel_id -> channels.id
node_health.node_id -> nodes.id
alarms.node_id -> nodes.id
alarms.channel_id -> channels.id
alarm_events.alarm_id -> alarms.id
alarm_events.changed_by_user_id -> users.id
work_orders.alarm_id -> alarms.id
work_orders.technician_user_id -> users.id

(** -> **)[*].style.stroke: "#6c6f85"
(** -> **)[*].style.stroke-width: 2
